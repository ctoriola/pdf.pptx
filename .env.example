# --- AI for the Condensed and Detailed slide types ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: use any other OpenAI-compatible provider instead of Groq
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Local Ollama (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Default Groq model
LLM_MODEL=llama-3.3-70b-versatile

# --- Backblaze B2 (lifts Vercel's 4.5 MB upload limit; up to 100 MB) ---
# All four must be set, or the app falls back to direct uploads. Then open /setup once.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# The bucket's "Endpoint" from the B2 Buckets page, e.g. s3.us-east-005.backblazeb2.com
B2_ENDPOINT=
MAX_STORAGE_UPLOAD_MB=100

# --- App ---
# Direct uploads (no B2). Defaults: 4.4 on Vercel, 50 elsewhere
# MAX_UPLOAD_MB=50
MAX_PAGES=80

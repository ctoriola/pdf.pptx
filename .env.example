# --- AI for the Condensed and Detailed slide types ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: use any other OpenAI-compatible provider instead of Groq
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Local Ollama (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Default Groq model
LLM_MODEL=llama-3.3-70b-versatile

# --- Firebase Storage (lifts Vercel's 4.5 MB upload limit) ---
# All five values below plus the service account must be set, or the app falls back to direct uploads.
# Web app config (Firebase console > Project settings > Your apps):
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=
# Service-account key (Project settings > Service accounts > Generate new private key):
# paste the whole JSON file on one line, or its base64 encoding
FIREBASE_SERVICE_ACCOUNT=
MAX_STORAGE_UPLOAD_MB=50

# --- App ---
# Direct uploads (no Firebase). Defaults: 4.4 on Vercel, 50 elsewhere
# MAX_UPLOAD_MB=50
MAX_PAGES=80

# --- AI for the Condensed and Detailed slide types ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: use any other OpenAI-compatible provider instead of Groq
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Local Ollama (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Optional: model(s) to prefer, comma-separated. Leave unset to let the app pick from what the
# provider currently offers (providers retire models; a retired one here is skipped automatically).
# LLM_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b

# --- Backblaze B2 (lifts Vercel's 4.5 MB upload limit; up to 100 MB) ---
# All four must be set, or the app falls back to direct uploads. Then open /setup once.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# The bucket's "Endpoint" from the B2 Buckets page, e.g. s3.us-east-005.backblazeb2.com
B2_ENDPOINT=
MAX_STORAGE_UPLOAD_MB=100

# --- App ---
# Direct uploads (no B2). Defaults: 4.4 on Vercel, 50 elsewhere
# MAX_UPLOAD_MB=50
MAX_PAGES=800
# Seconds of reading before a too-long PDF stops with a clear message (Vercel ends functions at 300 s)
READ_TIME_LIMIT=240
# Condensed and Detailed (AI) rewrite only the chosen sections, up to this many words:
# the LLM's free tier is rate-limited per minute
MAX_AI_WORDS=30000

# --- Storage setup page (owner only) ---
# The /setup page does not exist unless this is set (16+ characters). It is the password for
# that page. Set it only while you need the page, then remove it and redeploy.
# SETUP_TOKEN=

# --- OCR for scanned PDFs ---
# Scanned pages (pictures of text) are read with the Tesseract engine built into PyMuPDF, using the
# language data in ./tessdata (English only is shipped). Add e.g. fra.traineddata there for French.
# OCR_LANGUAGES=eng          # e.g. eng+fra
# OCR_DPI=200
# MAX_OCR_PAGES=40           # ~1-3 s per scanned page
# OCR_TESSDATA=./tessdata
